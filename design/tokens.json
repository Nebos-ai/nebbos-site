{
  "$schema": "https://json.schemastore.org/tokens.json",
  "$description": "Nebbos delta-brief editorial system · design tokens registry v1.0. Single source of truth for colors, type, motion, and layout. Consumed by /design page (living style guide) and by CI validators (Wave 3b).",
  "$version": "1.0.0",
  "$updated": "2026-08-23",

  "color": {
    "paper":     { "value": "#F4F1EA", "description": "Site background · warm cream" },
    "paper-2":   { "value": "#EFEBE2", "description": "Elevated surface · one step darker than paper" },
    "ink":       { "value": "#14120F", "description": "Body foreground · warm near-black" },
    "ink-2":     { "value": "#403C36", "description": "Secondary text · long copy" },
    "ink-3":     { "value": "#7A7365", "description": "Tertiary text · captions, mono" },
    "muted":     { "value": "#9A9284", "description": "Muted text · disabled, hint" },
    "rule":      { "value": "#C9C1B4", "description": "Hairline border · 1px dividers" },
    "rule-2":    { "value": "#DAD2C4", "description": "Softer hairline · sub-dividers" },
    "accent":    { "value": "#A36630", "description": "Deep gold · reserved secondary accent" },
    "accent-2":  { "value": "#F6A03F", "description": "Bright Nebbos orange · primary accent" },
    "gold":      { "value": "#A36630", "description": "Alias for accent · used in numerals" },
    "gold-2":    { "value": "#FDDA88", "description": "Light gold · dark-mode primary" }
  },

  "type": {
    "family": {
      "serif":  { "value": "Newsreader, 'Trust 3A', Georgia, serif", "description": "Display serif · Newsreader fallback to Trust 3A" },
      "sans":   { "value": "'Host Grotesk', -apple-system, system-ui, sans-serif", "description": "UI + body" },
      "mono":   { "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace", "description": "Numerals + eyebrows + labels" }
    },
    "size": {
      "hero-xl":  { "value": "clamp(48px, 6vw, 96px)", "description": "Hero H1" },
      "h1":       { "value": "clamp(40px, 5.5vw, 72px)", "description": "Section H1" },
      "h2":       { "value": "clamp(28px, 3.2vw, 42px)", "description": "FeatureRow title" },
      "h3":       { "value": "clamp(22px, 2.6vw, 32px)", "description": "Sub-section title" },
      "body-lg":  { "value": "18px", "description": "Lede paragraph" },
      "body":     { "value": "17px", "description": "Body copy" },
      "body-sm":  { "value": "15px", "description": "Sub-copy, detail panel body" },
      "eyebrow":  { "value": "11px", "description": "Mono eyebrow above titles" },
      "micro":    { "value": "10.5px", "description": "Captions, mono numerals" }
    }
  },

  "motion": {
    "duration": {
      "instant":  { "value": "75ms",  "description": "Instant micro-feedback" },
      "fast":     { "value": "120ms", "description": "Hover state transitions" },
      "default":  { "value": "180ms", "description": "Default component transitions" },
      "slow":     { "value": "275ms", "description": "ScrollReveal, section entry" },
      "page":     { "value": "400ms", "description": "View Transitions, page morph" }
    },
    "easing": {
      "out":      { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "description": "Ease-out · component enter" },
      "in":       { "value": "cubic-bezier(0.55, 0.055, 0.675, 0.19)", "description": "Ease-in · component exit" },
      "settle":   { "value": "cubic-bezier(0.19, 1, 0.22, 1)", "description": "Settle · section enter, generous decel" }
    },
    "spring": {
      "node":     { "stiffness": 260, "damping": 22, "mass": 0.9, "description": "Graph-node force-jitter · Wave 2E" },
      "hover":    { "stiffness": 320, "damping": 24, "description": "Hover feedback · Wave 2E" },
      "note":     { "stiffness": 320, "damping": 24, "description": "Note-card enter · Wave 2E" }
    }
  },

  "layout": {
    "container": {
      "max":      { "value": "1240px", "description": "Marketing content max-width" },
      "gutter":   { "value": "24px",   "description": "Container side padding" }
    },
    "measure": {
      "prose":    { "value": "72ch",   "description": "Optimal reading measure" },
      "title":    { "value": "22ch",   "description": "Max characters per line for H1/H2" }
    },
    "section": {
      "y":        { "value": "72px",   "description": "Default section vertical padding" },
      "mono-min": { "value": "92vh",   "description": "One-idea-per-viewport min-height · Wave 2C" }
    },
    "radius": {
      "cut-corner": { "value": "0 30px 0 0", "description": "Signature single top-right cut · cards, callouts" }
    }
  },

  "signature-devices": {
    "plus-marker": { "description": "Orange plus glyph · 19×1.5 arms · CSS pseudo-element (attached to `.plus-marker`) OR standalone via <PlusMark> primitive with size variants xs=12/sm=16/md=24/lg=48/xl=96." },
    "cut-corner-card": { "description": "Single top-right radius cut (0 30px 0 0). Applied via `.cut-corner` class." },
    "section-numeral": { "description": "Numbered section eyebrow: <PlusMark size='sm'/> + tabular numeral + `·` + LABEL. Applied via `.section-numeral` class with `.n` for the numeral span." },
    "section-mono":   { "description": "One-idea-per-viewport panel: min-height 92vh + place-content center + max-width 72ch. Applied via `.section-mono` class." },
    "arch-graph":     { "description": "15-layer knowledge graph as SVG. 15 nodes + 35 edges (peer + depends). Motion library: motion@13.1.1. Hand-laid positions in lib/architecture.ts." },
    "italic-gold-em": { "description": "`<em style={{ fontStyle: 'italic', color: 'var(--gold)' }}>` on 1-3 noun phrases per headline for voice." }
  },

  "$related-memories": [
    "moncalisse-doctrine-v2c-amendment",
    "doctrine-v2-motion-library-amendment",
    "railway-nebbos-site-project-location"
  ]
}
