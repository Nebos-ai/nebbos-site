# Controls canonical origin + indexing (ADR-278 AD-8).
#   production -> nebbos.ai, indexable
#   staging    -> idvor.ai, noindex (default if unset)
NEXT_PUBLIC_SITE_ENV=staging

# Public URL of the Nebbos App release manifest consumed by /download.
# Produced by the NLDA-6 / NLDA-7 signed-installer pipeline. When unset the
# download page degrades to a "not yet published" state instead of linking
# at a missing artifact.
# NEXT_PUBLIC_NEBBOS_RELEASE_MANIFEST=https://nebbos.ai/releases/app/latest.json
